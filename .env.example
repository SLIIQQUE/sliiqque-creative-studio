# Copy this file to .env.local and fill in real values. .env.local is gitignored and never committed.

# Required: powers /api/contact (the contact form and footer newsletter sign-up).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: the verified "From" address Resend sends as, e.g. "SLIIQQUE Studio <notifications@sliiqque.space>".
# Leave unset to use Resend's shared onboarding@resend.dev sandbox address, which only delivers to
# the email on your Resend account — fine for testing, not for real visitor submissions.
RESEND_FROM=

# ---------------------------------------------------------------------------
# Journal admin (see docs/journal-admin-cms-plan.md). Values go in Vercel project settings and .env.local only.
# ---------------------------------------------------------------------------

# Postgres connection string. In production use the pooled URL from the Neon integration on Vercel.
# Local development: a throwaway cluster, e.g. postgres://studio@localhost:54329/sliiqque_studio
DATABASE_URL=

# Address of the first owner. npm run db:seed creates this account. Only addresses in the users table can sign in.
OWNER_EMAIL=

# "json" (default) serves the journal from src/data/content.json. "db" serves it from the admin database.
# Switch to db after running scripts/import-journal.mts and checking the pages. Rollback is setting it back to json.
JOURNAL_SOURCE=json

# Vercel Blob read/write token for image uploads. Without it uploads go to ./storage/uploads (development only).
BLOB_READ_WRITE_TOKEN=

# Secret that authorises the scheduled-publish route. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Optional: only if the IndexNow key is ever rotated (the current key is public and served from public/).
INDEXNOW_KEY=
